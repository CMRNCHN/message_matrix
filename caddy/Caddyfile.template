{
	# LAN/dev: local_certs uses Caddy's internal CA (.local hostnames).
	# Public: set CADDY_TLS_MODE=public in .env (bootstrap omits local_certs → Let's Encrypt).
	__CADDY_TLS_DIRECTIVE__
	__CADDY_EMAIL_LINE__
}

# Element Web client (legacy / advanced)
{$ELEMENT_PUBLIC_HOST} {
	reverse_proxy element:80
}

# Message Matrix unified inbox
{$INBOX_PUBLIC_HOST} {
	reverse_proxy inbox-web:80
}

# Synapse client API + .well-known
{$SYNAPSE_PUBLIC_HOST} {
	# Matrix client discovery
	handle /.well-known/matrix/client {
		header Content-Type application/json
		respond `{"m.homeserver":{"base_url":"https://{$SYNAPSE_PUBLIC_HOST}"}}` 200
	}

	# Matrix server discovery (federation)
	handle /.well-known/matrix/server {
		header Content-Type application/json
		respond `{"m.server":"{$SYNAPSE_PUBLIC_HOST}:8448"}` 200
	}

	reverse_proxy synapse:8008
}

# Synapse federation (optional — disable inbound federation in homeserver.yaml if private)
{$SYNAPSE_PUBLIC_HOST}:8448 {
	reverse_proxy synapse:8008
}
