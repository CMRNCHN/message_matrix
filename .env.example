# Copy to .env and fill in before running ./scripts/bootstrap.sh

MATRIX_DOMAIN=example.com
MATRIX_SERVER_NAME=example.com
SYNAPSE_PUBLIC_URL=https://matrix.example.com
ELEMENT_PUBLIC_URL=https://chat.example.com
INBOX_PUBLIC_URL=https://app.example.com

# Hostnames only (no scheme) — used by Caddy; bootstrap syncs these from the URLs above
SYNAPSE_PUBLIC_HOST=matrix.example.com
ELEMENT_PUBLIC_HOST=chat.example.com
INBOX_PUBLIC_HOST=app.example.com

POSTGRES_PASSWORD=change-me-postgres
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me-registration-secret

SYNAPSE_ADMIN_USER=admin
SYNAPSE_ADMIN_PASSWORD=change-me-admin-password

DISABLE_FEDERATION=true

# Set by ./connect wizards (or manually)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BLUEBUBBLES_URL=http://host.docker.internal:1234
BLUEBUBBLES_PASSWORD=
GVOICE_ENABLED=false
META_NETWORK=messenger

CADDY_ACME_EMAIL=
CADDY_TLS_MODE=internal
